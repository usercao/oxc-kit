{
  "name": "vite-oxc-bridge",
  "version": "0.7.6",
  "description": "Configure Oxfmt and Oxlint from one typed config in Vite projects",
  "keywords": [
    "config",
    "formatter",
    "linter",
    "oxc",
    "oxfmt",
    "oxlint",
    "vite",
    "vite-plus"
  ],
  "homepage": "https://github.com/usercao/vite-oxc-bridge#readme",
  "bugs": {
    "url": "https://github.com/usercao/vite-oxc-bridge/issues"
  },
  "license": "MIT",
  "author": "usercao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usercao/vite-oxc-bridge.git"
  },
  "bin": {
    "oxc": "dist/cli.js",
    "oxfmt": "bin/oxfmt.js",
    "oxlint": "bin/oxlint.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/vite-plus-hooks.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "yarn format:check && yarn lint && yarn test && yarn test:package && yarn pack --dry-run",
    "format": "node src/cli.ts fmt .",
    "format:check": "node src/cli.ts fmt --check .",
    "lint": "node src/cli.ts lint .",
    "lint:fix": "node src/cli.ts lint --fix .",
    "prepack": "yarn build",
    "test": "tsc -p tsconfig.json && yarn build && vitest run",
    "test:package": "node scripts/package-smoke.ts",
    "test:windows": "yarn build && vitest run test/tool.test.ts test/integration.test.ts test/language-server.test.ts && yarn test:package"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsdown": "^0.23.7",
    "typescript": "^7",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "vite": ">=8.0.0"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "yarn@4.19.0"
}
