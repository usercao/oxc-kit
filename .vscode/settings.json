{
  // Use the project-local Oxfmt through the official Oxc extension
  "prettier.enable": false,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.detectIndentation": false,
  "editor.formatOnSave": true,
  "editor.insertSpaces": true,
  "editor.rulers": [100],
  "editor.tabSize": 2,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // Apply safe Oxlint fixes after formatting
  "editor.codeActionsOnSave": {
    "source.format.oxc": "always",
    "source.fixAll.oxc": "always",
    "source.organizeImports": "never"
  },

  // Use the workspace TypeScript version
  "js/ts.tsdk.path": "node_modules/typescript/lib",

  // Markdown uses trailing spaces for explicit line breaks
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },
  "oxc.configPath": "oxc.config.ts",
  "oxc.fmt.configPath": "oxc.config.ts",
  "oxc.disableNestedConfig": true,
  "oxc.fmt.disableNestedConfig": true,

  // Dogfood this repository's wrappers (run `yarn build` first)
  "oxc.path.oxfmt": "./bin/oxfmt.js",
  "oxc.path.oxlint": "./bin/oxlint.js",

  // Format JavaScript and TypeScript with the Oxc extension
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  // Format whole files and apply Oxlint fixes on save
  "editor.formatOnSaveMode": "file"
}
